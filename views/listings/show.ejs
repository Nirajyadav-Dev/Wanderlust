<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>
  </div>

  <div class="card col-6 offset-2 show-card listing-card">
    <img src="<%= listing.image ? listing.image.url : '' %>" class="card-img-top show-img" alt="listing_image">
    <div class="card-body mt-2">
      <p class="card-text">
        <%= listing.description %><br>
        &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> / night<br>
        <%= listing.location %><br>
        <%= listing.country %>
      </p>
    </div>
  </div>

  <div class="btns offset-2 col-8 d-flex gap-2 my-3">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>

    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
      <button class="btn btn-danger">Delete</button>
    </form>

    <a href="/listings" class="btn btn-outline-secondary">Back to Home</a>
  </div>
</div>